# ---- PostgreSQL ----
POSTGRES_USER=vindb
POSTGRES_PASSWORD=YOURPASSWORD
POSTGRES_DB=vindb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Vom Backend/ETL genutzte Verbindung (async fuer die API)
DATABASE_URL=postgresql+asyncpg://vindb:YOURPASSWORD@db:5432/vindb
# Synchron fuer ETL/Migrationen
DATABASE_URL_SYNC=postgresql://vindb:YOURPASSWORD@db:5432/vindb

# ---- Backend ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Live-Nachfrage bei NHTSA vPIC, wenn die eigene DB Luecken hat
ENABLE_LIVE_NHTSA=true
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_TIMEOUT_SECONDS=6
# CORS: erlaubte Frontend-Origins, kommagetrennt
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Bind-Adresse der veroeffentlichten Ports. 127.0.0.1 = nur lokal (Standard),
# 0.0.0.0 = im LAN erreichbar.
BIND_ADDRESS=127.0.0.1
